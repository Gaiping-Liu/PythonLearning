{
    "RuleSetList": 
    [
            {
                    "SupportLanguage": [
                            "en-us"
                    ],
                    "RuleList": [
                            {
                                "SearchPattern": "\\b(\\w{2,25})-(\\w+)-(\\w+)\\b(?!-\\w)",
                                "ReplacePattern": "$1 $2 $3",
                                "Comment": "Replace hyphen with space for compound word likse 'GLM-4-Voice'"
                            },
                            {
                                    "SearchPattern": "\\b(\\w{2,25})-(\\w{1,25})\\b(?!-\\w)",
                                    "ReplacePattern": "$1 $2",
                                    "Comment": "Replace hyphen with space for compound word likse 'GLM-4'"
                            }
                            
                    ]
            },
            {
                    "SupportLanguage": [
                            "en-in"
                    ],
                    "RuleList": [
                                {
                                        "SearchPattern": "\\b([A-Za-z]+)(-?)([\\u0980-\\u09FF]+)\\b",
                                        "ReplacePattern": "$1 $2 $3",
                                        "Comment": "$1 indicates that the English word matching condition is ([A-Za-z]+); $2 indicates that the input hyphen is optional and the matching condition is (-?); $3 indicates that the Bengali word matching condition is ([\\u0980-\\u09FF]+). The ReplacePattern adds spaces around the hyphen to separate the English and Bengali words."
                                }
                    ]
            },
            {
                    "SupportLanguage": [
                            "bn-in"
                    ],
                    "RuleList": [
                                {
                                        "SearchPattern": "\\b([A-Za-z]+)(-?)([\\u0980-\\u09FF]+)\\b",
                                        "ReplacePattern": "$1 $2 $3",
                                        "Comment": "$1 indicates that the English word matching condition is ([A-Za-z]+); $2 indicates that the input hyphen is optional and the matching condition is (-?); $3 indicates that the Bengali word matching condition is ([\\u0980-\\u09FF]+). The ReplacePattern adds spaces around the hyphen to separate the English and Bengali words."
                                }
                    ]
            },
            {
                    "SupportLanguage": [
                            "en-in",
                            "hi-in",
                            "ta-in",
                            "te-in",
                            "gu-in",
                            "mr-in",
                            "as-in",
                            "pa-in",
                            "or-in",
                            "kn-in",
                            "ml-in",
                            "bn-in"
                    ],
                    "RuleList": [
                                {
                                        "SearchPattern": "(?:(?<=[A-Za-z])-(?=[\\u0900-\\u097F\\u0980-\\u09FF\\u0A00-\\u0A7F\\u0A80-\\u0AFF\\u0B00-\\u0B7F\\u0B80-\\u0BFF\\u0C00-\\u0C7F\\u0C80-\\u0CFF\\u0D00-\\u0D7F])|(?<=[\\u0900-\\u097F\\u0980-\\u09FF\\u0A00-\\u0A7F\\u0A80-\\u0AFF\\u0B00-\\u0B7F\\u0B80-\\u0BFF\\u0C00-\\u0C7F\\u0C80-\\u0CFF\\u0D00-\\u0D7F])-(?=[A-Za-z]))",
                                        "ReplacePattern": " - ",
                                        "Comment": "Add spaces around a hyphen that joins an English word and an Indian-script word in either direction."
                                },
                                {
                                        "SearchPattern": "(?:(?<=[A-Za-z])(?=[\\u0900-\\u097F\\u0980-\\u09FF\\u0A00-\\u0A7F\\u0A80-\\u0AFF\\u0B00-\\u0B7F\\u0B80-\\u0BFF\\u0C00-\\u0C7F\\u0C80-\\u0CFF\\u0D00-\\u0D7F])|(?<=[\\u0900-\\u097F\\u0980-\\u09FF\\u0A00-\\u0A7F\\u0A80-\\u0AFF\\u0B00-\\u0B7F\\u0B80-\\u0BFF\\u0C00-\\u0C7F\\u0C80-\\u0CFF\\u0D00-\\u0D7F])(?=[A-Za-z]))",
                                        "ReplacePattern": " ",
                                        "Comment": "Insert a space between directly joined English and Indian-script characters in either direction."
                                },
                                {
                                        "SearchPattern": "\\b(?i)Vitara(?-i)\\b",
                                        "ReplacePattern": "<lang xml:lang='en-US'>Vitara</lang>",
                                        "Comment": "Vitara read in en-us way"
                                },
                                {
                                        "SearchPattern": "\\b(?i)Baleno(?-i)\\b",
                                        "ReplacePattern": "<lang xml:lang='en-US'>Baleno</lang>",
                                        "Comment": "Baleno read in en-us way"
                                },
                                {
                                        "SearchPattern": "\\b(?i)Ciaz(?-i)\\b",
                                        "ReplacePattern": "<lang xml:lang='en-US'><phoneme alphabet=\"ipa\" ph=\"si.ˈɑːz\">Ciaz</phoneme></lang>",
                                        "Comment": "Ciaz read in en-us way"
                                }, 
                                {
                                        "SearchPattern": "\\bADAS\\b",
                                        "ReplacePattern": "<lang xml:lang='en-US'><phoneme alphabet=\"ipa\" ph=\"ˈeɪˌdæs\">ADAS</phoneme></lang>",
                                        "Comment": "ADAS read in en-us way"
                                },
                                {
                                        "SearchPattern": "\\bARAI\\b",
                                        "ReplacePattern": "<lang xml:lang='en-US'><phoneme alphabet=\"ipa\" ph=\"eɪ.ar.eɪ.aiː\">ARAI</phoneme></lang>",
                                        "Comment": "ARAI read in en-us way"
                                },
                                {
                                        "SearchPattern": "\\b(?i)hybrid(?-i)\\b",
                                        "ReplacePattern": "<lang xml:lang='en-US'>hybrid</lang>",
                                        "Comment": "hybrid read in en-us way"
                                }
                    ]
            }
    ]
}
